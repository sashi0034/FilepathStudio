<Window x:Class="FilepathStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FilepathStudio"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        mc:Ignorable="d"
        x:Name="Window"
        Title="FilepathStudio" Height="600" Width="1000"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:TitleBar.ExtendViewIntoTitleBar="True"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              VerticalAlignment="Center"
              Height="{Binding ElementName=Window, Path=(ui:TitleBar.Height)}">

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:TitleBarButton x:Name="FileButton" Click="MenuButton_Click" Width="Auto">
                    <ui:TitleBarButton.Content>
                        <TextBlock Text="File" VerticalAlignment="Center" Margin="12,0" FontFamily="Segoe UI" FontSize="14" />
                    </ui:TitleBarButton.Content>
                    <ui:TitleBarButton.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open File" Click="OpenFile_Click" />
                            <MenuItem Header="Save File" Click="SaveFile_Click" />
                            <MenuItem Header="Save File As..." Click="SaveFileAs_Click" />
                            <Separator />
                            <MenuItem Header="Exit" Click="Exit_Click" />
                        </ContextMenu>
                    </ui:TitleBarButton.ContextMenu>
                </ui:TitleBarButton>

                <ui:TitleBarButton x:Name="TerminalButton" Click="MenuButton_Click" Width="Auto">
                    <ui:TitleBarButton.Content>
                        <TextBlock Text="Terminal" VerticalAlignment="Center" Margin="12,0" FontFamily="Segoe UI" FontSize="14" />
                    </ui:TitleBarButton.Content>
                    <ui:TitleBarButton.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open Terminal" Click="OpenTerminal_Click" />
                        </ContextMenu>
                    </ui:TitleBarButton.ContextMenu>
                </ui:TitleBarButton>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="#252525" BorderBrush="#333333" BorderThickness="0,1">
            <Grid Height="28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FilePathTextBlock" 
                           VerticalAlignment="Center" 
                           Margin="12,0" 
                           Foreground="#AAAAAA" 
                           FontSize="12"
                           TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1" 
                        Content="Copy Path" 
                        Margin="8,0,8,0" 
                        Padding="12,2"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Click="CopyPath_Click" />
            </Grid>
        </Border>

        <avalonedit:TextEditor
            Grid.Row="2"
            Name="Editor"
            FontFamily="Consolas"
            FontSize="14"
            ShowLineNumbers="True"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto"
            PreviewMouseWheel="Editor_PreviewMouseWheel">
        </avalonedit:TextEditor>
    </Grid>
</Window>
