<Window x:Class="FilepathStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FilepathStudio"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        mc:Ignorable="d"
        x:Name="Window"
        Title="FilepathStudio" Height="600" Width="1000"
        Icon="Assets/filepath_studio.ico"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:TitleBar.ExtendViewIntoTitleBar="True"
        Closing="Window_Closing">
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Open" Executed="OpenFile_Click" />
        <CommandBinding Command="ApplicationCommands.Save" Executed="SaveFile_Click" />
        <CommandBinding Command="ApplicationCommands.SaveAs" Executed="SaveFileAs_Click" />
        <CommandBinding Command="ApplicationCommands.Close" Executed="Exit_Click" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Command="ApplicationCommands.Open" Modifiers="Control" Key="O" />
        <KeyBinding Command="ApplicationCommands.Save" Modifiers="Control" Key="S" />
        <KeyBinding Command="ApplicationCommands.SaveAs" Modifiers="Control+Shift" Key="S" />
    </Window.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              VerticalAlignment="Center"
              Height="{Binding ElementName=Window, Path=(ui:TitleBar.Height)}">

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:TitleBarButton x:Name="FileButton" Click="MenuButton_Click" Width="Auto">
                    <ui:TitleBarButton.Content>
                        <TextBlock Text="File" VerticalAlignment="Center" Margin="12,0" FontFamily="Segoe UI" FontSize="14" />
                    </ui:TitleBarButton.Content>
                    <ui:TitleBarButton.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open File" Command="ApplicationCommands.Open" InputGestureText="Ctrl+O" />
                            <MenuItem Header="Save File" Command="ApplicationCommands.Save" InputGestureText="Ctrl+S" />
                            <MenuItem Header="Save File As..." Command="ApplicationCommands.SaveAs" InputGestureText="Ctrl+Shift+S" />
                            <Separator />
                            <MenuItem Header="Find" Command="ApplicationCommands.Find" InputGestureText="Ctrl+F" />
                            <MenuItem Header="Replace" Command="ApplicationCommands.Replace" InputGestureText="Ctrl+H" />
                            <Separator />
                            <MenuItem Header="Exit" Command="ApplicationCommands.Close" />
                        </ContextMenu>
                    </ui:TitleBarButton.ContextMenu>
                </ui:TitleBarButton>

                <ui:TitleBarButton x:Name="TerminalButton" Click="MenuButton_Click" Width="Auto">
                    <ui:TitleBarButton.Content>
                        <TextBlock Text="Terminal" VerticalAlignment="Center" Margin="12,0" FontFamily="Segoe UI" FontSize="14" />
                    </ui:TitleBarButton.Content>
                    <ui:TitleBarButton.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open Terminal" Click="OpenTerminal_Click" />
                        </ContextMenu>
                    </ui:TitleBarButton.ContextMenu>
                </ui:TitleBarButton>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="#252525" BorderBrush="#333333" BorderThickness="0,1">
            <Grid Height="28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FilePathTextBlock" 
                           VerticalAlignment="Center" 
                           Margin="12,0" 
                           Foreground="#AAAAAA" 
                           FontSize="12"
                           TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1" 
                        x:Name="CopyButton"
                        Content="Copy" 
                        Margin="8,0,8,0" 
                        Padding="12,2"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Click="CopyPath_Click" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <avalonedit:TextEditor
                Name="Editor"
                FontFamily="Consolas"
                FontSize="14"
                ShowLineNumbers="True"
                WordWrap="True"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                PreviewMouseWheel="Editor_PreviewMouseWheel"
                TextChanged="Editor_TextChanged">
            </avalonedit:TextEditor>

            <!-- Search and Replace Panel -->
            <Border x:Name="SearchPanel" 
                    Visibility="Collapsed"
                    VerticalAlignment="Top" 
                    HorizontalAlignment="Right" 
                    Margin="0,10,30,0" 
                    Background="#2D2D2D" 
                    BorderBrush="#454545" 
                    BorderThickness="1" 
                    CornerRadius="4"
                    Width="380">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Direction="270" RenderingBias="Quality" ShadowDepth="2" Opacity="0.4" />
                </Border.Effect>
                <StackPanel Margin="10">
                    <!-- Search Row -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchTextBox" 
                                 ui:ControlHelper.PlaceholderText="Find"
                                 KeyDown="SearchTextBox_KeyDown"
                                 TextChanged="SearchTextBox_TextChanged" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button x:Name="FindNextButton" Content="" FontFamily="Segoe MDL2 Assets" Click="FindNext_Click" Width="32" Padding="0" ToolTip="Find Next (Enter)" />
                            <Button x:Name="FindPrevButton" Content="" FontFamily="Segoe MDL2 Assets" Click="FindPrev_Click" Width="32" Padding="0" Margin="4,0" ToolTip="Find Previous (Shift+Enter)" />
                            <Button Content="" FontFamily="Segoe MDL2 Assets" Click="CloseSearch_Click" Width="32" Padding="0" ToolTip="Close (Esc)" />
                        </StackPanel>
                    </Grid>

                    <!-- Replace Row -->
                    <Grid x:Name="ReplaceRow" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ReplaceTextBox" 
                                 ui:ControlHelper.PlaceholderText="Replace"
                                 KeyDown="ReplaceTextBox_KeyDown" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button Content="Replace" Click="Replace_Click" Width="68" FontSize="12" ToolTip="Replace" />
                            <Button Content="All" Click="ReplaceAll_Click" Width="32" Margin="4,0" FontSize="12" ToolTip="Replace All" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
